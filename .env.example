# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Currency Exchange Rate API (cn.apihz.cn)
EXCHANGE_API_ID="10019329"
EXCHANGE_API_KEY="68c6ddd3e38d4bdcd64db29a3809eea8"

# Multi-language Translation API (cn.apihz.cn /api/zici/fanyiapihz.php)
# 把下面两项换成你在 https://www.apihz.cn 后台申请的独享 ID/KEY，
# 再把 TRANSLATE_RATE_LIMIT 调成你的实际每分钟上限（钻石会员可达 60+），
# 首次切换语言的耗时就会从 ~80s 降到 ~15s。
# 语种编号：1=英语 13=荷兰语 17=法语 19=德语 26=意大利语 41=西班牙语
# 注意：公共 ID/KEY 限频 10 次/分钟，建议登录接口盒子申请独享 ID/KEY
TRANSLATE_API_ID="10019329"
TRANSLATE_API_KEY="68c6ddd3e38d4bdcd64db29a3809eea8"

# 每分钟允许的上游调用次数（默认 9，对应公共 KEY 的 10 次/分钟硬限）
TRANSLATE_RATE_LIMIT="9"

# 客服 WhatsApp 悬浮气泡号码（国际格式，只写数字，不要 + 和空格）
# 例如香港号码 85212345678；不填则回落到代码里的占位号
VITE_WHATSAPP_NUMBER="85200000000"
